    "Notifications are turned off for this app in iOS Settings. Turn them on there and we will schedule it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitteilungen sind für diese App in den iOS-Einstellungen ausgeschaltet. Schalte sie dort ein, dann richten wir die Erinnerung ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications are turned off for this app in iOS Settings. Turn them on there and we will schedule it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones de esta app están desactivadas en Ajustes de iOS. Actívalas ahí y lo programaremos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уведомления для этого приложения выключены в Настройках iOS. Включи их там, и мы запланируем напоминание."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сповіщення для цього застосунку вимкнено в Налаштуваннях iOS. Увімкни їх там, і ми заплануємо нагадування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thông báo đã bị tắt cho ứng dụng này trong Cài đặt iOS. Hãy bật lại ở đó và chúng tôi sẽ đặt lịch."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
