          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplica el factor de demanda solo a ese subtotal: los primeros 3000 VA al 100%%, los %@ VA restantes al 35%%, para un resultado de %@ VA."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Применяй коэффициент спроса только к этому промежуточному итогу: первые 3000 VA по 100%%, остальные %@ VA по 35%%, получается %@ VA."
