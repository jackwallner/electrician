    "Grounding electrode conductor sizing from the service conductor, and equipment grounding conductor sizing from the overcurrent device." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bemessung des Erdungselektrodenleiters (GEC) nach dem Service-Leiter und des Betriebsmittel-Erdungsleiters (EGC) nach der Überstromschutzeinrichtung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grounding electrode conductor sizing from the service conductor, and equipment grounding conductor sizing from the overcurrent device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimensionamiento del conductor del electrodo de puesta a tierra según el conductor del servicio, y del conductor de puesta a tierra de equipos según el dispositivo de sobrecorriente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбор проводника заземляющего электрода по проводнику ввода (service) и выбор проводника заземления оборудования по устройству защиты от сверхтока."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переріз провідника заземлювального електрода визначають за провідником вводу, а переріз провідника заземлення обладнання за пристроєм захисту від надструму."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn cỡ dây nối đất điện cực dựa trên dây dẫn nguồn cấp chính, và chọn cỡ dây nối đất thiết bị dựa trên thiết bị bảo vệ quá dòng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接地极导体按进线导体确定规格,设备接地导体按过电流保护装置确定规格。"
          }
        }
      }
    },
