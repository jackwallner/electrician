    "Single-phase uses 2 as the factor, because that is the path the current actually takes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einphasig gilt 2 als Faktor, weil das der Weg ist, den der Strom tatsächlich nimmt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Single-phase uses 2 as the factor, because that is the path the current actually takes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monofásico usa 2 como factor, porque ese es el recorrido que realmente hace la corriente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для однофазной цепи множитель равен 2, потому что именно такой путь проходит ток."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В однофазній мережі коефіцієнт дорівнює 2, бо саме такий шлях проходить струм."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một pha dùng hệ số 2, vì đó là đường đi thực tế của dòng điện."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单相的系数取 2，因为电流实际走的就是这条往返路径。"
          }
        }
      }
    },
    "Single-phase uses 2 as the factor, because the current goes out and comes back." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einphasig gilt 2 als Faktor, weil der Strom hin- und zurückfließt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Single-phase uses 2 as the factor, because the current goes out and comes back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monofásico usa 2 como factor, porque la corriente va y regresa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для однофазной цепи множитель равен 2, потому что ток идёт туда и обратно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В однофазній мережі коефіцієнт дорівнює 2, бо струм іде туди й назад."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Một pha dùng hệ số 2, vì dòng điện đi ra rồi quay về."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单相的系数取 2，因为电流去了还要回来。"
          }
        }
      }
    },
