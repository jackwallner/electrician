    "Checked %@. Adoption and vendors change, and local amendments are common. Confirm with %@ before you rely on it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stand: %@. Die Übernahme und die Prüfungsanbieter ändern sich, und lokale Änderungen sind üblich. Bestätige es bei %@, bevor du dich darauf verlässt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checked %@. Adoption and vendors change, and local amendments are common. Confirm with %@ before you rely on it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verificado %@. La adopción y los proveedores cambian, y las enmiendas locales son comunes. Confirma con %@ antes de confiar en ello."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверено: %@. Принятые редакции и поставщики экзаменов меняются, а местные поправки встречаются часто. Прежде чем полагаться на это, уточни: %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірено %@. Чинна редакція кодексу та організатори іспитів змінюються, а місцеві поправки трапляються часто. Перш ніж покладатися на це, підтвердь у %@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đã kiểm tra %@. Việc áp dụng và các đơn vị tổ chức thi có thể thay đổi, và các sửa đổi theo địa phương rất phổ biến. Hãy xác nhận với %@ trước khi dựa vào thông tin này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "核对于 %@。采用情况和考试机构会变化，各地修订也很常见。使用前请向 %@ 确认。"
          }
        }
      }
    },
