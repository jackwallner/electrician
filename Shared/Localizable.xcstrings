    "Electrician cannot send reminders until notifications are turned on in iOS Settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrician kann erst Erinnerungen senden, wenn Mitteilungen in den iOS-Einstellungen aktiviert sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrician cannot send reminders until notifications are turned on in iOS Settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrician no puede enviar recordatorios hasta que actives las notificaciones en Ajustes de iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrician не может присылать напоминания, пока уведомления не включены в Настройках iOS."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrician не може надсилати нагадування, доки сповіщення не ввімкнено в Налаштуваннях iOS."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrician không thể gửi nhắc nhở cho đến khi bạn bật thông báo trong Cài đặt của iOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iOS“设置”中开启通知之前，Electrician 无法发送提醒。"
          }
        }
      }
    },
    "Electrician uses %@ values, unchanged across the %@. A different edition or local amendment can change an answer, so verify against the code in force where you work." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrician verwendet %@-Werte, unverändert über die %@ hinweg. Eine andere Ausgabe oder lokale Änderung kann eine Antwort ändern. Prüfe daher gegen den Code, der dort gilt, wo du arbeitest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrician uses %@ values, unchanged across the %@. A different edition or local amendment can change an answer, so verify against the code in force where you work."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrician usa valores de %@, sin cambios en %@. Una edición distinta o una enmienda local puede cambiar una respuesta, así que verifica con el código vigente donde trabajas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrician использует значения %@, без изменений в рамках: %@. Другая редакция или местная поправка может изменить ответ, поэтому сверяйся с кодексом, действующим там, где ты работаешь."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrician використовує значення %1$@, без змін для: %2$@. Інша редакція чи місцева поправка може змінити відповідь, тож звіряйся з кодексом, чинним там, де ти працюєш."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrician dùng các giá trị của %@, không đổi xuyên suốt %@. Ấn bản khác hoặc sửa đổi của địa phương có thể làm đổi đáp án, nên hãy đối chiếu với quy chuẩn đang có hiệu lực nơi bạn làm việc."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Electrician 使用 %1$@ 的数值，在整个 %2$@ 中保持不变。不同版本或地方修订可能改变答案，请以你所在地生效的规范为准。"
          }
        }
      }
    },
