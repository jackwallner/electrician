        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Theo phương pháp tiêu chuẩn cho nhà ở, nhu cầu theo cột C của Table 220.55 cho một bếp điện gia dụng 16 kW là bao nhiêu?"
          }
        },
        "zh-Hans" : {
