    "The full journeyman/electrician licence exam" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die vollständige Journeyman-/Electrician-Lizenzprüfung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The full journeyman/electrician licence exam"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El examen completo de licencia de oficial electricista (journeyman)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полный экзамен на лицензию электрика уровня journeyman"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
