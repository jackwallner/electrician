    "In a dwelling living room, how far along the wall may a point be from the nearest receptacle outlet?" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie weit darf in einem Wohnzimmer eines Wohngebäudes ein Punkt entlang der Wand von der nächsten Steckdose entfernt sein?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a dwelling living room, how far along the wall may a point be from the nearest receptacle outlet?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la sala de estar de una vivienda, ¿a qué distancia a lo largo de la pared puede estar un punto de la salida de receptáculo más cercana?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В гостиной жилого дома (dwelling): на каком расстоянии вдоль стены может находиться любая точка от ближайшей розетки?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вітальні житлового будинку: на якій відстані вздовж стіни може бути будь-яка точка від найближчої розетки?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong phòng khách của nhà ở, một điểm dọc theo tường được cách ổ cắm gần nhất tối đa bao xa?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "住宅客厅里，墙上任意一点距离最近的插座出线口最远可以是多少？"
          }
        }
      }
    },
    "In a dwelling living room, what is the minimum width of an uninterrupted wall space that falls under the general receptacle-spacing rule?" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie breit muss ein ununterbrochenes Wandstück in einem Wohnzimmer eines Wohngebäudes mindestens sein, damit die allgemeine Regel zum Steckdosenabstand greift?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In a dwelling living room, what is the minimum width of an uninterrupted wall space that falls under the general receptacle-spacing rule?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la sala de estar de una vivienda, ¿cuál es el ancho mínimo de un tramo de pared sin interrupciones que cae bajo la regla general de separación de receptáculos?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В гостиной жилого дома (dwelling): какова минимальная ширина сплошного участка стены, на который распространяется общее правило расстановки розеток?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вітальні житлового будинку: яка мінімальна ширина суцільної ділянки стіни, на яку поширюється загальне правило розміщення розеток?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong phòng khách của nhà ở, đoạn tường liền không bị ngắt quãng có bề rộng tối thiểu bao nhiêu thì thuộc quy tắc bố trí ổ cắm thông thường?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "住宅客厅里，适用一般插座间距规则的连续墙面，最小宽度是多少？"
          }
        }
      }
    },
