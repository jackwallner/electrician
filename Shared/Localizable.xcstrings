    "%@ unlocks the extra sets here and in every other room, the worked calculations, Code Minute, Exam Warm-Up, and Endless Practice. Everything you already have stays free." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ schaltet die zusätzlichen Sets hier und in jedem anderen Raum frei, dazu die ausgearbeiteten Berechnungen, Code-Minute, Prüfungs-Warm-up und Endlos-Übung. Alles, was du schon hast, bleibt kostenlos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ unlocks the extra sets here and in every other room, the worked calculations, Code Minute, Exam Warm-Up, and Endless Practice. Everything you already have stays free."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ desbloquea los conjuntos extra aquí y en todas las demás salas, los cálculos resueltos, Minuto del Código, Calentamiento para el examen y Práctica sin fin. Todo lo que ya tienes sigue gratis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ открывает дополнительные наборы здесь и в каждом другом разделе, разобранные расчёты, «Минуту кодекса», «Разминку перед экзаменом» и «Бесконечную практику». Всё, что у тебя уже есть, остаётся бесплатным."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ відкриває додаткові набори тут і в кожному іншому розділі, розібрані розрахунки, Хвилину NEC, Розминку перед іспитом і Нескінченну практику. Усе, що вже є, лишається безкоштовним."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ mở khóa các bộ bổ sung ở đây và ở mọi phòng khác, các bài tính có lời giải, Code Minute, Khởi động kỳ thi và Luyện tập vô tận. Mọi thứ bạn đang có vẫn miễn phí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 会解锁这里和其他每个专区的更多题组、例题详解、规范一分钟、考前热身和无尽练习。你已有的内容仍然免费。"
          }
        }
      }
    },
    "%@ values, unchanged across the %@. Copper and aluminum, THHN/THWN in EMT. Other raceways and insulations, and local amendments, are not covered." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-Werte, unverändert über %@ hinweg. Kupfer und Aluminium, THHN/THWN in EMT. Andere Raceways und Isolierungen sowie lokale Änderungen sind nicht abgedeckt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ values, unchanged across the %@. Copper and aluminum, THHN/THWN in EMT. Other raceways and insulations, and local amendments, are not covered."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valores de %@, sin cambios en %@. Cobre y aluminio, THHN/THWN en EMT. No se cubren otras canalizaciones ni aislamientos, ni las enmiendas locales."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значения %@ не меняются в %@. Медь и алюминий, THHN/THWN в EMT. Другие каналы (raceway), виды изоляции и местные поправки не учитываются."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значення %@, однакові для всіх: %@. Мідь і алюміній, THHN/THWN в EMT. Інші канали прокладки (raceway), типи ізоляції та місцеві поправки не охоплені."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các giá trị %@ không thay đổi trong các ấn bản %@. Đồng và nhôm, THHN/THWN trong EMT. Không bao gồm các loại ống luồn dây và cách điện khác, cũng như các sửa đổi của địa phương."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 的数值，在 %@ 中保持不变。适用于铜和铝，EMT 中的 THHN/THWN。其他布线管槽、绝缘类型和地方修订条款不在范围内。"
          }
        }
      }
    },
