    "The motor nameplate full-load current" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Volllaststrom laut Motor-Typenschild"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The motor nameplate full-load current"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La corriente de plena carga de la placa de datos del motor"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ток полной нагрузки по шильдику двигателя"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Струм повного навантаження зі шильдика двигуна"
          }
        },
        "vi" : {
          "stringUnit" : {
