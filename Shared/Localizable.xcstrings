    "14, 12 and 10 AWG copper": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "14, 12 and 10 AWG copper"
          }
        }
      }
    },
    "14, 12 and 10 AWG copper are capped at 15, 20 and 30 amps for ordinary general-purpose overcurrent protection unless a specific code permission applies. Aluminum 12 and 10 cap at 15 and 25. More candidates lose points to this one rule than to any other in the book.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "14, 12 and 10 AWG copper are capped at 15, 20 and 30 amps for ordinary general-purpose overcurrent protection unless a specific code permission applies. Aluminum 12 and 10 cap at 15 and 25. More candidates lose points to this one rule than to any other in the book."
          }
        }
      }
    },
    "14, 12 and 10 AWG copper are capped at 15, 20 and 30 amps for overcurrent protection no matter what the ampacity table says. Aluminum 12 and 10 cap at 15 and 25. More candidates lose points to this one rule than to any other in the book.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "14, 12 and 10 AWG copper are capped at 15, 20 and 30 amps for overcurrent protection no matter what the ampacity table says. Aluminum 12 and 10 cap at 15 and 25. More candidates lose points to this one rule than to any other in the book."
          }
        }
      }
    },
    "15, 20 and 30 amps, regardless": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "15, 20 and 30 amps, regardless"
          }
        }
      }
    },
    "1500 VA for each small-appliance circuit, and 1500 VA for the laundry circuit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1500 VA for each small-appliance circuit, and 1500 VA for the laundry circuit"
          }
        }
      }
    },
    "1800 × 3 VA = 5400 VA. The 3 VA per square foot covers the lighting AND the general-use receptacle outlets together, which is why a dwelling calculation never counts living-room receptacles individually.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1800 × 3 VA = 5400 VA. The 3 VA per square foot covers the lighting AND the general-use receptacle outlets together, which is why a dwelling calculation never counts living-room receptacles individually."
          }
        }
      }
    },
    "20 A is itself a standard rating, so no rounding is needed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "20 A is itself a standard rating, so no rounding is needed."
          }
        }
      }
    },
    "21,600 ÷ 240 = 90 A, and 90 is a standard rating, but a one-family dwelling service has a 100 ampere floor. The calculation tells you the minimum is not exceeded; the floor tells you what to install.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "21,600 ÷ 240 = 90 A, and 90 is a standard rating, but a one-family dwelling service has a 100 ampere floor. The calculation tells you the minimum is not exceeded; the floor tells you what to install."
          }
        }
      }
    },
