    "Add 25%% of the largest retained motor under 220.50 and 430.24: %@ × 0.25 = %@ VA." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Addiere 25%% des größten Motors in der Berechnung nach 220.50 und 430.24: %@ × 0.25 = %@ VA."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add 25%% of the largest retained motor under 220.50 and 430.24: %@ × 0.25 = %@ VA."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suma 25%% del motor más grande incluido según 220.50 y 430.24: %@ × 0.25 = %@ VA."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавь 25%% от самого большого оставляемого в расчёте двигателя по 220.50 и 430.24: %@ × 0.25 = %@ VA."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додай 25%% найбільшого двигуна, що залишається в розрахунку, за 220.50 і 430.24: %@ × 0.25 = %@ VA."
