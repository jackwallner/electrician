    "Total 20,240 + 6500 = 26,740 VA. Divided by 240 V that is 111.4 A, so a 125 A service." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Summe 20,240 + 6500 = 26,740 VA. Geteilt durch 240 V sind das 111.4 A, also ein 125-A-Service."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total 20,240 + 6500 = 26,740 VA. Divided by 240 V that is 111.4 A, so a 125 A service."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total 20,240 + 6500 = 26,740 VA. Dividido entre 240 V son 111.4 A, así que un servicio de 125 A."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Итого 20,240 + 6500 = 26,740 VA. Делим на 240 V и получаем 111.4 A, значит, ввод (service) на 125 A."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разом 20,240 + 6500 = 26,740 VA. Поділивши на 240 V, отримуємо 111.4 A, тобто ввід на 125 A."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tổng 20,240 + 6500 = 26,740 VA. Chia cho 240 V được 111.4 A, vậy nguồn cấp chính (service) là 125 A."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "合计 20,240 + 6500 = 26,740 VA。除以 240 V 得 111.4 A，所以进线为 125 A。"
          }
        }
      }
    },
