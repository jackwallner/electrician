    "Two weeks is enough, if you spend it right" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zwei Wochen reichen, wenn du sie richtig nutzt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two weeks is enough, if you spend it right"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dos semanas bastan, si las aprovechas bien"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двух недель хватит, если потратить их правильно"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Двох тижнів досить, якщо витратити їх правильно"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai tuần là đủ, nếu bạn dùng đúng cách"
