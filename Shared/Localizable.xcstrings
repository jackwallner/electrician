    "Code Basics first. Knowing where a question lives is worth more than knowing any single answer." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zuerst die Code-Grundlagen. Zu wissen, wo eine Frage im Code liegt, ist mehr wert, als irgendeine einzelne Antwort zu kennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Code Basics first. Knowing where a question lives is worth more than knowing any single answer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero, Fundamentos del Código. Saber dónde encontrar la respuesta a una pregunta vale más que saber una respuesta aislada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала основы кодекса. Знать, где искать ответ на вопрос, ценнее, чем знать любой отдельный ответ."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спершу Основи NEC. Знати, де шукати відповідь на питання, цінніше, ніж знати будь-яку окрему відповідь."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NEC cơ bản trước tiên. Biết một câu hỏi nằm ở đâu trong sách còn đáng giá hơn biết một đáp án riêng lẻ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先学规范基础。知道一道题的答案在规范哪里，比记住任何单个答案都有价值。"
