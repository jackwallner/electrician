        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mọi thứ từ điểm đấu nối với lưới điện đến và gồm cả thiết bị ngắt nguồn cấp chính: cần bao nhiêu thiết bị ngắt, được đặt ở đâu, khoảng cách an toàn khi đi trên không và đi ngầm, và những gì được đấu vào phía trước chúng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从公用电网接入点到进线断开装置（含）：断开装置的数量、可以设在哪里、架空和地下净距，以及可以在它们前面连接什么。"
          }
        }
      }
    },
