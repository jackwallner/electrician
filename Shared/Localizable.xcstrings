    "Your purchase went through, but %@ hasn't unlocked yet. Give it a moment, then tap Restore. You will not be charged twice." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Kauf ist durchgegangen, aber %@ ist noch nicht freigeschaltet. Warte einen Moment und tippe dann auf „Wiederherstellen“. Dir wird nichts doppelt berechnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your purchase went through, but %@ hasn't unlocked yet. Give it a moment, then tap Restore. You will not be charged twice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu compra se realizó, pero %@ aún no se ha desbloqueado. Espera un momento y toca Restaurar. No se te cobrará dos veces."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покупка прошла, но доступ к %@ ещё не открылся. Подожди немного и нажми «Восстановить». Повторно деньги не спишутся."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покупку проведено, але %@ ще не розблоковано. Зачекай трохи, потім торкнись «Відновити». Гроші не спишуться вдруге."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giao dịch mua của bạn đã thành công, nhưng %@ chưa được mở khóa. Chờ một lát rồi chạm Khôi phục. Bạn sẽ không bị tính phí hai lần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "购买已完成，但 %@ 还没有解锁。稍等片刻，然后点按“恢复”。不会重复扣费。"
          }
        }
      }
    },
    "Your recent practice is consistent across the rooms you have opened." : {
