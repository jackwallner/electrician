    "Table 250.122 has a row at %lld A, so read it directly." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Table 250.122 hat eine Zeile bei %lld A, lies sie also direkt ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Table 250.122 has a row at %lld A, so read it directly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Tabla 250.122 tiene una fila de %lld A, así que léela directamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Table 250.122 есть строка на %lld A, поэтому читай её напрямую."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У Table 250.122 є рядок на %lld A, тож читай його напряму."
          }
        },
        "vi" : {
