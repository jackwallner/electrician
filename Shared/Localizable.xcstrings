          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "电动机铭牌上的满载电流"
          }
        }
      }
    },
    "The nameplate %@ A is still used, but only for the separate overload device under 430.32." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Typenschildwert von %@ A wird weiterhin verwendet, aber nur für die separate Überlasteinrichtung nach 430.32."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The nameplate %@ A is still used, but only for the separate overload device under 430.32."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los %@ A de la placa de datos se siguen usando, pero solo para el dispositivo de sobrecarga aparte según 430.32."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ток %@ A по шильдику всё равно используется, но только для отдельного устройства защиты от перегрузки по 430.32."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Значення %@ A зі шильдика все ще використовується, але лише для окремого пристрою захисту від перевантаження за 430.32."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giá trị %@ A trên nhãn thông số (nameplate) vẫn được dùng, nhưng chỉ cho thiết bị bảo vệ quá tải riêng theo 430.32."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "铭牌上的 %@ A 仍然会用到，但只用于 430.32 规定的独立过载保护装置。"
          }
        }
      }
    },
    "The nameplate is not the number here. Branch-circuit conductors for a single motor are sized from the full-load current in Table %@, which for a %@ motor at %@ is %@ A." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Typenschild liefert hier nicht die Zahl. Leiter des Abzweigkreises für einen einzelnen Motor werden nach dem Volllaststrom in Table %@ bemessen, der für einen Motor mit %@ bei %@ gleich %@ A beträgt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The nameplate is not the number here. Branch-circuit conductors for a single motor are sized from the full-load current in Table %@, which for a %@ motor at %@ is %@ A."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí la placa de datos no es el número. Los conductores del circuito derivado (branch circuit) de un solo motor se dimensionan con la corriente de plena carga de la Tabla %@, que para un motor de %@ a %@ es %@ A."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь нужен не шильдик. Проводники групповой цепи (branch circuit) для одного двигателя выбирают по току полной нагрузки из Table %@, который для двигателя %@ при %@ равен %@ A."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тут число не зі шильдика. Провідники групового кола для одного двигуна підбирають за струмом повного навантаження з Table %@, який для двигуна %@ при %@ становить %@ A."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ở đây không dùng số trên nhãn thông số (nameplate). Dây dẫn mạch nhánh của một động cơ được chọn cỡ theo dòng đầy tải trong Table %@, với động cơ %@ ở %@ là %@ A."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里用的不是铭牌值。单台电动机的分支回路导体按 Table %@ 中的满载电流确定尺寸，%@ 电动机在 %@ 时为 %@ A。"
          }
        }
      }
    },
    "The nameplate says 28 amps" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem Typenschild stehen 28 A"
          }
        },
        "en" : {
