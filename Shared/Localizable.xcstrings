    "Services, feeders, load calculations, wiring methods and the special occupancy chapters are not covered yet. Keep studying those from your own book." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Services, Feeder, Lastberechnungen, Verdrahtungsmethoden und die Kapitel zu Sonderbereichen sind noch nicht abgedeckt. Lerne diese weiter aus deinem eigenen Buch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Services, feeders, load calculations, wiring methods and the special occupancy chapters are not covered yet. Keep studying those from your own book."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servicios, los alimentadores (feeders), los cálculos de carga, los métodos de cableado y los capítulos de ocupaciones especiales aún no están cubiertos. Sigue estudiándolos con tu propio libro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вводы, фидеры, расчёты нагрузки, способы прокладки и главы о специальных объектах пока не охвачены. Изучай их по своей книге."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вводи, фідери, розрахунки навантаження, способи електропроводки та глави про спеціальні приміщення ще не охоплено. Вивчай їх за власною книгою."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nguồn cấp chính, mạch cấp (feeder), tính toán tải, phương pháp đi dây và các chương về nơi sử dụng đặc biệt chưa có trong app. Hãy tiếp tục ôn những phần đó từ sách của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进线、馈线、负载计算、布线方式和特殊场所章节暂未涵盖。这些内容请继续用你自己的规范书学习。"
          }
        }
      }
    },
