    "Column C of Table 220.55 gives 14 kW for three ranges. That is the starting figure, and it already assumes each range is not over 12 kW.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Column C of Table 220.55 gives 14 kW for three ranges. That is the starting figure, and it already assumes each range is not over 12 kW."
          }
        }
      }
    },
    "Column C starts at 8 kW for one range and rises 5% for each kilowatt over 12. Sixteen is four over, so 8 × 1.20 = 9.6 kW. Answering 8 kW ignores the increase and answering 16 ignores the table altogether.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Column C starts at 8 kW for one range and rises 5% for each kilowatt over 12. Sixteen is four over, so 8 × 1.20 = 9.6 kW. Answering 8 kW ignores the increase and answering 16 ignores the table altogether."
          }
        }
      }
    },
