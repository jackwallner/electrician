    "%@. Everything you have stays free; %@ is the half that does not run out before then." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Alles, was du hast, bleibt kostenlos; %@ ist die Hälfte, die dir bis dahin nicht ausgeht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Everything you have stays free; %@ is the half that does not run out before then."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Todo lo que ya tienes sigue gratis; %@ es la mitad que no se agota antes de esa fecha."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Всё, что у тебя есть, остаётся бесплатным, а %@ даёт вторую половину: она не кончится до этого срока."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Усе, що в тебе є, лишається безкоштовним; %@ дає другу половину, яка не закінчиться раніше."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Mọi thứ bạn đang có vẫn miễn phí; %@ là nửa còn lại, không cạn trước ngày thi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。你已有的内容保持免费；%@ 则是到那时也不会用完的那一半。"
          }
        }
      }
    },
