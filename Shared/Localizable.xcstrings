            "state" : "translated",
            "value" : "Ein einzelner Haushaltsherd mit 11 kW. Was geht in die Berechnung ein?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A single 11 kW household range. What goes into the calculation?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una estufa doméstica de 11 kW. ¿Qué entra en el cálculo?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одна бытовая плита 11 kW. Что идёт в расчёт?"
          }
        },
        "uk" : {
          "stringUnit" : {
