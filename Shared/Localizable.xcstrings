    "Four fastened-in-place appliances (%@ + %@ + %@ + %@ = %@ VA) reach the four-appliance threshold, so 220.53 takes them at 75%%: %@ VA." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vier fest montierte Geräte (%@ + %@ + %@ + %@ = %@ VA) erreichen die Schwelle von vier Geräten, daher setzt 220.53 sie mit 75%% an: %@ VA."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Four fastened-in-place appliances (%@ + %@ + %@ + %@ = %@ VA) reach the four-appliance threshold, so 220.53 takes them at 75%%: %@ VA."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuatro aparatos fijados en su lugar (%@ + %@ + %@ + %@ = %@ VA) alcanzan el umbral de cuatro aparatos, así que 220.53 los toma al 75%%: %@ VA."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Четыре прибора, закреплённые на месте (%@ + %@ + %@ + %@ = %@ VA), достигают порога в четыре прибора, поэтому по 220.53 берётся 75%%: %@ VA."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чотири стаціонарно закріплені прилади (%@ + %@ + %@ + %@ = %@ VA) досягають порога в чотири прилади, тож за 220.53 їх беруть за 75%%: %@ VA."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bốn thiết bị gắn cố định (%@ + %@ + %@ + %@ = %@ VA) đạt ngưỡng bốn thiết bị, nên 220.53 tính chúng ở mức 75%%: %@ VA."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "四台固定安装电器 (%@ + %@ + %@ + %@ = %@ VA) 达到四台的门槛，因此 220.53 按 75%% 计算：%@ VA。"
          }
        }
      }
    },
    "Four more on scope, the double 125%, and Annex C" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vier weitere Fragen zu Geltungsbereich, der zweifachen Anwendung von 125% und Annex C"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Four more on scope, the double 125%, and Annex C"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuatro más sobre alcance, el doble 125% y el Anexo C"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ещё четыре о сфере применения, двойных 125% и Annex C"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ще чотири про сферу застосування, подвійні 125% та Annex C"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thêm bốn câu về phạm vi áp dụng, hệ số 125% kép, và Annex C"
