    "%@ generates the calculations instead of storing them. %lld problem shapes, new numbers every time, so the practice cannot run out before the exam does." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ erzeugt die Berechnungen, statt sie zu speichern. %lld Aufgabentypen, jedes Mal neue Zahlen, damit dir der Übungsstoff nicht vor der Prüfung ausgeht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ generates the calculations instead of storing them. %lld problem shapes, new numbers every time, so the practice cannot run out before the exam does."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ genera los cálculos en lugar de guardarlos. %lld tipos de problema, con números nuevos cada vez, para que no te quedes sin práctica antes del examen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ генерирует расчёты, а не хранит их. Типов задач: %lld, каждый раз новые числа, поэтому практика не закончится раньше экзамена."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ генерує розрахунки, а не зберігає їх. Типів задач: %lld, щоразу нові числа, тож практика не закінчиться раніше за іспит."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tạo phép tính ngay khi cần thay vì lưu sẵn. %lld dạng bài, mỗi lần một bộ số mới, nên bài luyện sẽ không cạn trước khi đến ngày thi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 现场生成计算题，而不是存一套固定题库。共 %lld 种题型，每次数字都不同，所以在考试到来之前，练习题不会用完。"
          }
        }
      }
    },
