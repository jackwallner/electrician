          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La placa de datos dice 28 amperios"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На шильдике 28 A"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
