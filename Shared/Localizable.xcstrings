    "%@ A is itself a standard rating in 240.6(A), so %lld A is the answer with no rounding needed." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ A ist selbst ein Standardnennwert nach 240.6(A), also ist %lld A die Antwort, ganz ohne Runden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ A is itself a standard rating in 240.6(A), so %lld A is the answer with no rounding needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ A ya es un valor estándar en 240.6(A), así que la respuesta es %lld A, sin necesidad de redondear."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ A уже является стандартным номиналом по 240.6(A), поэтому ответ: %lld A, округление не требуется."
