          }
        }
      }
    },
    "A motor with a marked service factor of 1.15 or higher, or a marked temperature rise of 40°C or less, gets overload protection at 125% of the nameplate full-load current. Everything else gets 115%. The question always gives you the service factor, and it gives it to you because it matters.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A motor with a marked service factor of 1.15 or higher, or a marked temperature rise of 40°C or less, gets overload protection at 125% of the nameplate full-load current. Everything else gets 115%. The question always gives you the service factor, and it gives it to you because it matters."
          }
        }
      }
    },
    "A one-family dwelling calculates to 21,600 VA on a 120/240 V service. What is the minimum service rating?": {
