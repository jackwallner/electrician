    "430.22 puts the conductors at 125%% of that: %@ × 1.25 = %@ A before rounding." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "430.22 setzt die Leiter auf 125%% davon an: %@ × 1.25 = %@ A vor dem Runden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "430.22 puts the conductors at 125%% of that: %@ × 1.25 = %@ A before rounding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "430.22 fija los conductores en el 125%% de eso: %@ × 1.25 = %@ A antes de redondear."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По 430.22 проводники рассчитываются на 125%% от этого тока: %@ × 1.25 = %@ A до округления."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "430.22 встановлює для провідників 125%% від цього: %@ × 1.25 = %@ A до округлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "430.22 đặt dây dẫn ở 125%% của mức đó: %@ × 1.25 = %@ A trước khi làm tròn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "430.22 要求导体按其 125%% 选取：%@ × 1.25 = %@ A（取整前）。"
          }
        }
      }
    },
    "430.22 puts the conductors at 125%% of that: %@ × 1.25 = %@ A." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
