    "Along a kitchen countertop wall, how far may a point be from the nearest receptacle?" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie weit darf an einer Wand mit Küchenarbeitsplatte ein Punkt von der nächsten Steckdose entfernt sein?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Along a kitchen countertop wall, how far may a point be from the nearest receptacle?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lo largo de la pared de una encimera de cocina, ¿a qué distancia máxima puede estar un punto del receptáculo más cercano?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вдоль стены с кухонной столешницей: на каком расстоянии от ближайшей розетки может находиться любая точка?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уздовж стіни з кухонною стільницею: на якій відстані від найближчої розетки може бути будь-яка точка?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dọc tường mặt bàn bếp, một điểm được cách ổ cắm gần nhất tối đa bao xa?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "沿厨房台面墙，任一点离最近的插座最远可以有多远？"
          }
        }
      }
    },
