          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The technical paper overlaps the master exam. The business-and-law paper is separate and this app does not cover it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El examen técnico comparte contenido con el examen de maestro electricista (master). El examen de negocios y leyes es aparte y esta app no lo cubre."
          }
        },
        "ru" : {
          "stringUnit" : {
