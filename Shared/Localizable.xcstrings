    "Tab your book. Candidates who tab and candidates who do not are not taking the same test." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setz Reiter in dein Buch. Prüflinge, die ihr Buch mit Reitern versehen, und Prüflinge, die es nicht tun, schreiben nicht dieselbe Prüfung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tab your book. Candidates who tab and candidates who do not are not taking the same test."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ponle pestañas a tu libro. Los candidatos que las usan y los que no, no presentan el mismo examen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расставь закладки в своей книге. Кандидаты с закладками и без них сдают как будто разные экзамены."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Познач книгу закладками. Кандидати, які це роблять, і ті, хто ні, складають не один і той самий іспит."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dán tab vào sách của bạn. Thí sinh có dán tab và thí sinh không dán tab không làm cùng một bài thi."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给你的规范书贴好索引标签。贴标签的考生和不贴的考生，考的根本不是同一场试。"
          }
        }
      }
    },
