            "value" : "Their total: %lld VA"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su total: %lld VA"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Их сумма: %lld VA"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разом: %lld VA"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tổng của chúng: %lld VA"
          }
        },
        "zh-Hans" : {
