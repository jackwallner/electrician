{
  "sourceLanguage": "en",
  "strings": {
    "\"Shall\" is mandatory. \"Shall not\" is prohibited. \"Shall be permitted\" means allowed but not required, and that third one is where candidates lose points: an answer that says something is required when the code only permits it is wrong even though the practice is common.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Shall\" is mandatory. \"Shall not\" is prohibited. \"Shall be permitted\" means allowed but not required, and that third one is where candidates lose points: an answer that says something is required when the code only permits it is wrong even though the practice is common."
          }
        }
      }
    },
    "%@ (from %@)": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (from %@)"
          }
        }
      }
    },
    "%@ A is itself a standard rating in 240.6(A), so %lld A is the answer with no rounding needed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ A is itself a standard rating in 240.6(A), so %lld A is the answer with no rounding needed."
          }
        }
      }
    },
    "%@ A is not a standard rating. The next-rating permission applies here: 430.52(C)(1)(a) permits the next standard size, so %lld A.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ A is not a standard rating. The next-rating permission applies here: 430.52(C)(1)(a) permits the next standard size, so %lld A."
          }
        }
      }
    },
    "%@ A is not a standard rating. This is the one calculation in the book that rounds UP: 430.52(C)(1) Exception 1 permits the next standard size, so %lld A.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ A is not a standard rating. This is the one calculation in the book that rounds UP: 430.52(C)(1) Exception 1 permits the next standard size, so %lld A."
          }
        }
      }
    },
