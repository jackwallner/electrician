    "3/4\" EMT is 0.533 in²; 40% is 0.21 in², which covers 0.19 in². 3/4\" is the answer." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3/4\" EMT hat 0.533 in²; 40% sind 0.21 in², das deckt 0.19 in² ab. 3/4\" ist die Antwort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3/4\" EMT is 0.533 in²; 40% is 0.21 in², which covers 0.19 in². 3/4\" is the answer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El EMT de 3/4\" tiene 0.533 in²; el 40% es 0.21 in², que cubre 0.19 in². La respuesta es 3/4\"."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3/4\" EMT: 0.533 in²; 40% это 0.21 in², чего хватает для 0.19 in². Ответ: 3/4\"."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Внутрішня площа 3/4\" EMT становить 0.533 in²; 40% це 0.21 in², чого вистачає для 0.19 in². Відповідь: 3/4\"."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EMT 3/4\" có 0.533 in²; 40% là 0.21 in², đủ cho 0.19 in². Đáp án là 3/4\"."
