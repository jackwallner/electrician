          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задачі, на яких провалюються"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những bài tính khiến người ta trượt"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
