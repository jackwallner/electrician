    "%@ VA ÷ 240 V = %@ A, and the smallest standard rating that carries it is %lld A.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ VA ÷ 240 V = %@ A, and the smallest standard rating that carries it is %lld A."
          }
        }
      }
    },
    "%@ VA ÷ 240 V ≈ %@ A. Use the unrounded current to select the smallest standard rating that carries it: %lld A.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ VA ÷ 240 V ≈ %@ A. Use the unrounded current to select the smallest standard rating that carries it: %lld A."
