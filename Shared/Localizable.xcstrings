            "value" : "Ambos conductores, y a partir de qué se dimensiona cada uno"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оба проводника и от чего рассчитывается каждый"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обидва провідники та за чим підбирають кожен"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cả hai dây dẫn, và mỗi dây được chọn cỡ dựa trên gì"
