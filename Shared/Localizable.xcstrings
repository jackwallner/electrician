      }
    },
    "%@ A is not a standard rating. The next-rating permission applies here: 430.52(C)(1)(a) permits the next standard size, so %lld A." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ A ist kein Standardnennwert. Hier greift die Erlaubnis für den nächsten Nennwert: 430.52(C)(1)(a) erlaubt die nächste Standardgröße, also %lld A."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ A is not a standard rating. The next-rating permission applies here: 430.52(C)(1)(a) permits the next standard size, so %lld A."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ A no es un valor estándar. Aquí aplica el permiso del siguiente valor: 430.52(C)(1)(a) permite el siguiente tamaño estándar, así que %lld A."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ A не является стандартным номиналом. Здесь действует разрешение выбрать следующий номинал: 430.52(C)(1)(a) допускает следующий стандартный номинал, поэтому ответ: %lld A."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ A не є стандартним номіналом. Тут діє дозвіл на наступний номінал: 430.52(C)(1)(a) дозволяє взяти наступний стандартний розмір, тому %lld A."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ A không phải định mức tiêu chuẩn. Ở đây áp dụng quyền chọn định mức kế tiếp: 430.52(C)(1)(a) cho phép dùng cỡ tiêu chuẩn kế tiếp, nên là %lld A."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ A 不是标准额定值。这里适用取下一档的许可：430.52(C)(1)(a) 允许取下一个标准规格，所以是 %lld A。"
          }
        }
      }
    },
    "%@ A is not a standard rating. This is the one calculation in the book that rounds UP: 430.52(C)(1) Exception 1 permits the next standard size, so %lld A." : {
