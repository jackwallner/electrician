          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto decide qué sala abrimos primero y si ves el repaso inicial."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "От этого зависит, какой раздел мы откроем первым и покажем ли тебе краткий вводный курс."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Від цього залежить, який розділ ми відкриємо першим і чи покажемо вступ."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều này quyết định phòng nào mở trước và bạn có được xem bài nhập môn hay không."
