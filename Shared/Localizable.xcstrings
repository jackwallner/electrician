    "Branch circuits, box fill, and dwelling-unit receptacle and GFCI rules carry the most weight." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abzweigkreise, Box Fill und die Regeln für Receptacles und GFCI in Wohneinheiten haben das meiste Gewicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Branch circuits, box fill, and dwelling-unit receptacle and GFCI rules carry the most weight."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los circuitos derivados, el llenado de caja y las reglas de receptáculos y GFCI en viviendas son los que más pesan."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Больше всего веса имеют групповые цепи, заполнение коробки и правила для розеток и GFCI в жилых помещениях (dwelling unit)."
          }
        },
        "uk" : {
          "stringUnit" : {
