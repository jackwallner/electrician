    "Short-circuit and ground-fault protection is sized from the TABLE full-load current, not the nameplate: %@ at %@ is %@ A in Table %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzschluss- und Erdschlussschutz wird nach dem Volllaststrom aus der TABELLE bemessen, nicht nach dem Typenschild: %@ bei %@ sind %@ A in Table %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Short-circuit and ground-fault protection is sized from the TABLE full-load current, not the nameplate: %@ at %@ is %@ A in Table %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La protección contra cortocircuito y falla a tierra se dimensiona con la corriente a plena carga de la TABLA, no con la placa de datos: %@ a %@ es %@ A en la Tabla %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Защита от короткого замыкания и замыкания на землю подбирается по току полной нагрузки из ТАБЛИЦЫ, а не по шильдику: %@ при %@ это %@ A по Table %@."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захист від короткого замикання й замикання на землю підбирають за струмом повного навантаження з ТАБЛИЦІ, а не за шильдиком: %@ при %@ дає %@ A у Table %@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bảo vệ ngắn mạch và chạm đất được chọn cỡ theo dòng đầy tải trong BẢNG, không phải nhãn thông số: %@ ở %@ là %@ A trong Table %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短路和接地故障保护按表中的满载电流确定，而不是铭牌：在 Table %4$@ 中，%1$@ 在 %2$@ 时为 %3$@ A。"
          }
        }
      }
    },
