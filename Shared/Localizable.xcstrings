          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La misma vivienda calculada con el método estándar y con el opcional, para ver la diferencia"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один и тот же жилой дом, рассчитанный стандартным и альтернативным методом, чтобы была видна разница"
