        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按 220.50 和 430.24，加上保留的最大电动机的 25%%：%@ × 0.25 = %@ VA。"
          }
        }
      }
    },
