    },
    "Older than the app's %@. Ampacity tables, the small-conductor rule and overcurrent sizing are the same in practice; GFCI and AFCI coverage, receptacle placement and the surge-protection and emergency-disconnect requirements are where the two cycles differ. Practice the calculations here and check those areas in your own book.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Older than the app's %@. Ampacity tables, the small-conductor rule and overcurrent sizing are the same in practice; GFCI and AFCI coverage, receptacle placement and the surge-protection and emergency-disconnect requirements are where the two cycles differ. Practice the calculations here and check those areas in your own book."
          }
        }
      }
    },
    "Older than the app's %@. Many calculation values match, but the 10 A standard breaker rating was added in 2023, and Article 220, ambient-correction and motor-protection citations moved. GFCI and AFCI coverage and receptacle placement also differ. Check the edition and amendments listed by your exam board.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Older than the app's %@. Many calculation values match, but the 10 A standard breaker rating was added in 2023, and Article 220, ambient-correction and motor-protection citations moved. GFCI and AFCI coverage and receptacle placement also differ. Check the edition and amendments listed by your exam board."
          }
        }
      }
    },
