    "125% where the service factor is 1.15 or more, or the temperature rise is 40°C or less. 115% otherwise. This is the ONLY figure on this screen that comes from the nameplate." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "125%, wenn der Betriebsfaktor (Service Factor) 1.15 oder mehr beträgt oder die Temperaturerhöhung 40°C oder weniger beträgt. Sonst 115%. Das ist der EINZIGE Wert auf diesem Bildschirm, der vom Typenschild stammt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "125% where the service factor is 1.15 or more, or the temperature rise is 40°C or less. 115% otherwise. This is the ONLY figure on this screen that comes from the nameplate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "125% cuando el factor de servicio es 1.15 o más, o el aumento de temperatura es de 40°C o menos. 115% en los demás casos. Este es el ÚNICO dato de esta pantalla que sale de la placa de datos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "125%, если сервис-фактор (service factor) 1.15 или выше либо превышение температуры 40°C или ниже. В остальных случаях 115%. Это ЕДИНСТВЕННОЕ значение на этом экране, которое берётся с шильдика."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "125%, якщо коефіцієнт запасу (service factor) становить 1.15 або більше, або перевищення температури 40°C чи менше. В інших випадках 115%. Це ЄДИНЕ значення на цьому екрані, яке береться зі шильдика."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "125% khi hệ số sử dụng (service factor) từ 1.15 trở lên, hoặc độ tăng nhiệt từ 40°C trở xuống. Các trường hợp khác là 115%. Đây là con số DUY NHẤT trên màn hình này lấy từ nhãn thông số (nameplate)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用系数为 1.15 或更高，或温升为 40°C 或更低时取 125%，其余取 115%。这是本页上唯一来自铭牌的数值。"
          }
        }
      }
    },
    "14, 12 and 10 AWG copper" : {
      "extractionState" : "manual",
      "localizations" : {
