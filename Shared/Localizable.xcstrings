    "Report %@ A as %@ A to the nearest 0.1 A. Compare actual loads against the unrounded allowable ampacity." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib %@ A als %@ A an, auf 0.1 A genau. Vergleiche die tatsächlichen Lasten mit der ungerundeten zulässigen Strombelastbarkeit (Ampacity)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Report %@ A as %@ A to the nearest 0.1 A. Compare actual loads against the unrounded allowable ampacity."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reporta %@ A como %@ A, al 0.1 A más cercano. Compara las cargas reales con la ampacidad permitida sin redondear."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запиши %@ A как %@ A с точностью до 0.1 A. Сравнивай фактические нагрузки с неокруглённым допустимым током (ampacity)."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вкажи %@ A як %@ A з точністю до 0.1 A. Порівнюй фактичні навантаження з незаокругленим допустимим струмом (ampacity)."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi %@ A là %@ A, làm tròn đến 0.1 A gần nhất. So tải thực tế với dòng cho phép (ampacity) chưa làm tròn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把 %@ A 取整到最接近的 0.1 A，写作 %@ A。实际负载要与未取整的允许载流量比较。"
          }
        }
      }
    },
