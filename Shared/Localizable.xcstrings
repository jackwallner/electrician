    "%lld shapes, and every problem is generated the moment you see it, so you can practise for as long as you like without repeating a question." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Aufgabentypen, und jede Aufgabe wird in dem Moment erzeugt, in dem du sie siehst. So kannst du beliebig lange üben, ohne dass sich eine Frage wiederholt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld shapes, and every problem is generated the moment you see it, so you can practise for as long as you like without repeating a question."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld tipos de problema, y cada problema se genera en el momento en que lo ves, así que puedes practicar todo el tiempo que quieras sin repetir una pregunta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Типов задач: %lld. Каждая задача создаётся в момент показа, поэтому можешь заниматься сколько хочешь, и вопросы не повторятся."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Типів задач: %lld. Кожна задача генерується в момент, коли ти її відкриваєш, тож можеш практикуватися скільки завгодно без повторів."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld dạng bài, và mỗi bài tính được tạo ngay khi bạn mở ra, nên bạn có thể luyện bao lâu tùy ý mà không gặp lại câu hỏi cũ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 种题型，每道题都在你看到的那一刻生成，所以你想练多久就练多久，不会遇到重复的题。"
          }
        }
      }
    },
