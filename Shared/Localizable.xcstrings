          }
        }
      }
    },
    "Table 250.122 has no %lld A row. The rows are not-exceeding bands, so %lld A reads the %lld A row." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Table 250.122 hat keine Zeile für %lld A. Die Zeilen sind Bänder mit Obergrenze (nicht überschreitend), also gilt für %lld A die Zeile %lld A."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Table 250.122 has no %lld A row. The rows are not-exceeding bands, so %lld A reads the %lld A row."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Tabla 250.122 no tiene una fila de %lld A. Las filas son rangos de valor máximo, así que %lld A se lee en la fila de %lld A."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В Table 250.122 нет строки на %lld A. Строки задают диапазоны «не более», поэтому %lld A относится к строке %lld A."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У Table 250.122 немає рядка на %lld A. Рядки це діапазони «не більше», тож %lld A читається за рядком %lld A."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Table 250.122 không có hàng %lld A. Các hàng là dải không vượt quá, nên %lld A đọc theo hàng %lld A."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Table 250.122 中没有 %lld A 这一行。各行是“不超过”的区间，所以 %lld A 要读 %lld A 那一行。"
          }
        }
      }
    },
