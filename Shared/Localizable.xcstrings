        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ begrenzt den Wert dann: Eine Elektrode vom Typ %@ erfordert nie mehr als %@ Kupfer, also ist die Leitung dorthin %@."
