    "%@ allowances × %@ in³ = %@ in³ before rounding. Report %@ in³ to the nearest 0.01 in³; use the unrounded minimum when selecting a physical box." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Zuschläge × %@ in³ = %@ in³ vor dem Runden. Gib %@ in³ auf 0.01 in³ genau an; bei der Wahl einer tatsächlichen Box gilt der ungerundete Mindestwert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ allowances × %@ in³ = %@ in³ before rounding. Report %@ in³ to the nearest 0.01 in³; use the unrounded minimum when selecting a physical box."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ asignaciones × %@ in³ = %@ in³ antes de redondear. Indica %@ in³ al 0.01 in³ más cercano; usa el mínimo sin redondear al elegir una caja real."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Норм объёма: %@ × %@ in³ = %@ in³ до округления. Ответ: %@ in³ с округлением до 0.01 in³; при выборе реальной коробки используй неокруглённый минимум."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ од. об’єму × %@ in³ = %@ in³ до округлення. Запиши %@ in³ з точністю до 0.01 in³; для вибору реальної коробки використовуй неокруглений мінімум."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ phần tính × %@ in³ = %@ in³ trước khi làm tròn. Ghi %@ in³, làm tròn đến 0.01 in³ gần nhất; khi chọn hộp thực tế hãy dùng giá trị tối thiểu chưa làm tròn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 个容积当量 × %@ in³ = %@ in³（取整前）。结果精确到 0.01 in³，报为 %@ in³；选择实际接线盒时使用未取整的最小值。"
          }
        }
      }
    },
