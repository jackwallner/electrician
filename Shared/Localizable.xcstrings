    "%@ VA ÷ 240 V = %@ A, and the smallest standard rating that carries it is %lld A." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ VA ÷ 240 V = %@ A, und der kleinste Standardnennwert, der diesen Strom trägt, ist %lld A."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ VA ÷ 240 V = %@ A, and the smallest standard rating that carries it is %lld A."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ VA ÷ 240 V = %@ A, y el valor estándar más pequeño que la soporta es %lld A."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ VA ÷ 240 V = %@ A, наименьший стандартный номинал, который выдерживает этот ток, равен %lld A."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ VA ÷ 240 V = %@ A, а найменший стандартний номінал, що витримує цей струм, це %lld A."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ VA ÷ 240 V = %@ A, và định mức tiêu chuẩn nhỏ nhất chịu được dòng này là %lld A."
