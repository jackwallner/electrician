    "This decides which room we open first and whether you get the primer." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das entscheidet, welchen Raum wir zuerst öffnen und ob du die Einführung bekommst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
