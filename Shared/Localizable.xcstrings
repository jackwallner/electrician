          }
        }
      }
    },
    "This is a different rule from the working space and gets confused with it constantly. The working space is where a person stands, in front. The dedicated space is the column directly above and below the equipment footprint, and it is reserved from foreign systems: no plumbing, no ductwork, no leaks from above. Sprinkler protection is allowed, and a suspended ceiling does not count as a structural ceiling.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a different rule from the working space and gets confused with it constantly. The working space is where a person stands, in front. The dedicated space is the column directly above and below the equipment footprint, and it is reserved from foreign systems: no plumbing, no ductwork, no leaks from above. Sprinkler protection is allowed, and a suspended ceiling does not count as a structural ceiling."
          }
        }
      }
    },
