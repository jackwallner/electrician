    "Worked Calculations for anything you missed, because a miss is almost always one skipped step." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechenbeispiele zu deinen Fehlern, denn meist wurde nur ein Schritt übersehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Worked Calculations for anything you missed, because a miss is almost always one skipped step."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cálculos resueltos de lo que fallaste, porque casi siempre un fallo es un paso omitido."
