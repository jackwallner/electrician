    "The one place you round up" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die eine Stelle, an der du aufrundest"
          }
        },
        "en" : {
