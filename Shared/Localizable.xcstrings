    "Conductor at its table resistance, not at operating temperature." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leiter mit seinem Tabellenwiderstand, nicht bei Betriebstemperatur."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conductor at its table resistance, not at operating temperature."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conductor con su resistencia de tabla, no a la temperatura de operación."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проводник при сопротивлении по таблице, а не при рабочей температуре."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Провідник з опором за таблицею, а не за робочої температури."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dây dẫn tính theo điện trở trong bảng, không theo nhiệt độ vận hành."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导体按表中电阻取值，而不是工作温度下的电阻。"
          }
        }
      }
    },
    "Conductor protection only: the load is already settled and no next-size-up allowance applies. What is the largest standard overcurrent device this conductor may be protected at?" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Leiterschutz: Die Last steht bereits fest, und es gibt keine Aufrundung auf die nächste Standardgröße. Auf welchen größten Standardnennwert darf dieser Leiter mit einer Überstromschutzeinrichtung abgesichert werden?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conductor protection only: the load is already settled and no next-size-up allowance applies. What is the largest standard overcurrent device this conductor may be protected at?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo protección del conductor: la carga ya está definida y no se aplica el tamaño inmediato superior. ¿Cuál es el dispositivo de sobrecorriente estándar más grande con el que se puede proteger este conductor?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Защита только проводника: нагрузка уже определена, и округление до следующего большего номинала не применяется. Какое наибольшее стандартное устройство защиты от сверхтока допустимо для этого проводника?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лише захист провідника: навантаження вже визначене, і правило наступного більшого номіналу не застосовується. Який найбільший стандартний пристрій захисту від надструму може захищати цей провідник?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ bảo vệ dây dẫn: tải đã được xác định và không áp dụng ngoại lệ nâng lên cỡ tiêu chuẩn kế tiếp. Thiết bị bảo vệ quá dòng tiêu chuẩn lớn nhất có thể bảo vệ dây dẫn này là bao nhiêu?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只保护导体：负载已经确定，不适用向上取下一档的规定。这根导体最大可以用多大的标准过电流保护装置来保护？"
          }
        }
      }
    },
