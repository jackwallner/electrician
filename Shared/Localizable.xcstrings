        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld dây nối đất thiết bị gộp lại chỉ tính là MỘT phần tính, không phải %lld."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 根设备接地导体合计只算一个容积当量，而不是 %lld 个。"
