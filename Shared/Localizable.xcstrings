          }
        }
      }
    },
    "You may begin correction and adjustment from the 90°C ampacity of a 90°C-rated conductor, then compare the result against the termination limit. That is the whole trick: derate from 90, terminate at 75, take the lower number. Starting the derate from the 75°C value is the most common way to get a right-looking wrong answer.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may begin correction and adjustment from the 90°C ampacity of a 90°C-rated conductor, then compare the result against the termination limit. That is the whole trick: derate from 90, terminate at 75, take the lower number. Starting the derate from the 75°C value is the most common way to get a right-looking wrong answer."
          }
        }
      }
    },
